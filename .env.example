# Copy to .env (never commit it). Without these the app runs in SIMULATED SERVICES mode.
NEBIUS_API_KEY=replace_me
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL_ID=replace_with_a_nemotron_model_id_from_your_account
# Launcher uses a persistent attempted-call cap. Zero disables inference; explicitly set a small ceiling after confirming credits.
JITD_MAX_MODEL_CALLS=0

# Optional cost estimates. Leave unset to show unpriced instead of invented USD.
# Use the rates applicable to your model/host; these are not provider billing.
# JITD_PRICE_INPUT_USD_PER_M=
# JITD_PRICE_OUTPUT_USD_PER_M=
# JITD_RUNTIME_USD_PER_MS=

# Optional external authority CSV (no synthetic fallback when selected).
# See docs/EXTERNAL_INTEGRATION.md for schema and trust requirements.
# JITD_AUTHORITY_CSV=C:/path/to/authority.csv
# JITD_AUTHORITY_SOURCE=finance-control

# GET-only HTTP shadow connector uses these optional read-only bearer tokens.
# Endpoint URLs are explicit CLI arguments; see docs/HTTP_INTEGRATION.md.
# JITD_PROVIDER_TOKEN=
# JITD_AUTHORITY_TOKEN=

# Optional single-workspace hosted access gate (username jitd).
# HTTPS required on a public host. Local loopback is unchanged when unset.
# JITD_REQUIRE_AUTH=1
# JITD_ACCESS_TOKEN=generate_a_long_random_value

# Optional named-user profile. Create users with python -m jitd.admin user-add NAME --role ROLE.
# JITD_PROFILE=enterprise
# JITD_ALLOWED_HOSTS=localhost,127.0.0.1,demo.your-domain.example
# JITD_DATA_DIR=C:/path/to/jitd-data
# Keys can instead be entered through python -m jitd.launch --ask-api-key (hidden, not saved).

# Optional output budget override for reasoning models (1..8192; provider charges apply).
# JITD_MODEL_MAX_OUTPUT_TOKENS=4096

# Optional Studio model roles. Both fall back to NEBIUS_MODEL_ID.
# Exact available NVIDIA IDs must come from your account. Role configuration is not evidence of measured savings.
# JITD_ARCHITECT_MODEL_ID=
# JITD_REPAIR_MODEL_ID=
